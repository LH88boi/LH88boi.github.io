{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u5730\u4e0b\u5934\u6728","text":"\u5730\u4e0b\u5934\u6728 <p>\u4e00\u5904\u5b89\u9759\u7684\u89d2\u843d\uff0c\u8bb0\u5f55\u6240\u89c1\u4e0e\u6240\u60f3\u3002</p>"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u6211\u662f\u5730\u4e0b\u5934\u6728\u3002</p> <p>\u8fd9\u91cc\u653e\u4e00\u6bb5\u7b80\u5355\u7684\u81ea\u6211\u4ecb\u7ecd\u5360\u4f4d\u6587\u5b57\u3002\u53ef\u4ee5\u5199\u5199\u6211\u662f\u8c01\u3001\u5e73\u65f6\u5173\u5fc3\u4ec0\u4e48\u3001\u4e3a\u4ec0\u4e48\u5efa\u8fd9\u4e2a\u5c0f\u7ad9\u3002</p>"},{"location":"about/#_2","title":"\u8054\u7cfb\u65b9\u5f0f","text":"<ul> <li>\u90ae\u7bb1\uff1a\uff08\u5f85\u8865\u5145\uff09</li> <li>GitHub\uff1a\uff08\u5f85\u8865\u5145\uff09</li> </ul>"},{"location":"jottings/","title":"\u5929\u7f51","text":"<p>\u6355\u6349\u65e5\u5e38\u91cc\u6563\u843d\u7684\u4fe1\u53f7\uff0c\u4e00\u7bc7\u4e00\u7bc7\u8bb0\u4e0b\u6765\u3002</p> <p>\u2728 \u5728\u7ebf\u5199\u4e00\u7bc7\u65e5\u8bb0\uff08\u6253\u5f00\u540e\u53ef\u76f4\u63a5\u5728\u7f51\u9875\u4e0a\u5199\u4f5c\u5e76\u81ea\u52a8\u53d1\u5e03\uff09</p>"},{"location":"jottings/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\u65e5\u8bb0</li> </ul>"},{"location":"jottings/example/","title":"\u793a\u4f8b\u65e5\u8bb0","text":"<p>\u8fd9\u662f\u4e00\u7bc7\u683c\u5f0f\u793a\u4f8b\u3002\u4ee5\u540e\u5199\u65b0\u6587\u7ae0\uff0c\u590d\u5236\u8fd9\u4e2a\u6587\u4ef6\uff0c\u6539\u6389\u6807\u9898\u548c\u5185\u5bb9\u5c31\u884c\u3002</p> <p>\u65e5\u671f\uff1a 2026-11-18 \u6807\u7b7e\uff1a \u65e5\u8bb0 / \u968f\u7b14</p>"},{"location":"jottings/example/#_2","title":"\u4eca\u5929\u505a\u4e86\u4ec0\u4e48","text":"<p>\u5728\u8fd9\u91cc\u5199\u6b63\u6587\u3002\u7528\u4e8c\u7ea7\u6807\u9898\u5206\u5c0f\u8282\uff0c\u6bb5\u843d\u4e4b\u95f4\u7a7a\u4e00\u884c\u3002</p>"},{"location":"jottings/example/#_3","title":"\u4e00\u70b9\u60f3\u6cd5","text":"<ul> <li>\u60f3\u6cd5\u4e00</li> <li>\u60f3\u6cd5\u4e8c</li> </ul> <p>\u4e0a\u4e00\u7bc7\uff1a\uff08\u6682\u65e0\uff09\u3000\uff5c\u3000\u4e0b\u4e00\u7bc7\uff1a\uff08\u6682\u65e0\uff09</p>"}]}